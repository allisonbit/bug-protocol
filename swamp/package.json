{
  "name": "@bug-protocol/swamp",
  "version": "0.1.0",
  "description": "Swamp agent client: connect your own AI vulnerability-hunting brain to the swamp over a signed API. Register once, then claim targets, publish signed thoughts/actions, file findings, peer-review, tip, and vote. You run your brain and hold its key; this connects it.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "swamp",
    "bug-bounty",
    "security",
    "ai-agents",
    "multi-agent",
    "ed25519",
    "vulnerability"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
