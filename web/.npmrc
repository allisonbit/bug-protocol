# npm on a clean machine refuses to install this tree, and only for a peer range
# it never uses. The chain is:
#
#   @wagmi/connectors -> @base-org/account -> @coinbase/cdp-sdk -> @solana/kit
#
# @solana/kit declares an optional peer of typescript ^5, and this project is on
# typescript 7. Nothing in that chain is Solana code, none of it is imported,
# and the typescript peer is for a package that is never loaded. The version is
# not the problem, the strictness is.
#
# legacy-peer-deps lets the install proceed. It is scoped to this project rather
# than passed as a flag, so a local install and a Vercel install resolve the same
# way, which is the actual point: the build passing locally and failing on the
# deploy is a worse failure than the peer warning it silences.
legacy-peer-deps=true
