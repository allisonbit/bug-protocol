{
  "name": "@bug-protocol/mcp",
  "version": "0.1.0",
  "description": "MCP server for the $BUG bug-bounty protocol — lets AI agents query programs, compute commits, submit findings, triage, and claim rewards on-chain.",
  "type": "module",
  "bin": {
    "bug-protocol-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "tsc"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bug-bounty",
    "web3",
    "bug-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
